<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Instaworkz | Web Design & Tech Assistance</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800;900&family=Open+Sans:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
:root{
  --dark:#080c14;
  --dark2:#0d1220;
  --dark3:#111827;
  --dark4:#161e2e;
  --blue:#2563eb;
  --blue-light:#3b82f6;
  --blue-bright:#60a5fa;
  --blue-pale:#93c5fd;
  --white:#ffffff;
  --off-white:#e8edf5;
  --muted:#8fa3bf;
  --border:rgba(96,165,250,0.13);
  --border2:rgba(255,255,255,0.07);
  --nav-h:70px;
  --r:6px;
  --shadow:0 4px 32px rgba(0,0,0,0.45);
}
body{font-family:'Open Sans',sans-serif;background:var(--dark);color:var(--off-white);overflow-x:hidden;line-height:1.6}
a{text-decoration:none;color:inherit}

/* TOP BAR */
.topbar{background:#050810;border-bottom:1px solid rgba(37,99,235,0.2);padding:.55rem 5%;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
.topbar-left{display:flex;align-items:center;gap:2rem;flex-wrap:wrap}
.topbar a{font-size:.8rem;color:var(--muted);transition:color .2s;display:flex;align-items:center;gap:.4rem}
.topbar a:hover{color:var(--blue-bright)}
.topbar-emergency{background:var(--blue) !important;color:#fff !important;padding:.35rem 1rem;border-radius:3px;font-size:.78rem !important;font-weight:700;letter-spacing:.03em;white-space:nowrap;transition:background .2s !important}
.topbar-emergency:hover{background:var(--blue-light) !important}
.blink{animation:blink 1.4s infinite;display:inline-block}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* NAV */
nav{position:sticky;top:0;z-index:200;height:var(--nav-h);background:rgba(8,12,20,.97);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 5%}
.logo{font-family:'Raleway',sans-serif;font-weight:900;font-size:1.45rem;letter-spacing:-.02em;color:var(--white);display:flex;align-items:center}
.logo-accent{color:var(--blue-light)}
.logo-dot{width:7px;height:7px;background:var(--blue);border-radius:50%;display:inline-block;margin-left:3px;margin-bottom:8px}
.nav-menu{display:flex;align-items:center;gap:.2rem;list-style:none}
.nav-menu a{color:rgba(232,237,245,.7);font-size:.875rem;font-weight:500;padding:.5rem .85rem;border-radius:var(--r);transition:color .2s,background .2s;white-space:nowrap}
.nav-menu a:hover{color:var(--white);background:rgba(255,255,255,.05)}
.nav-phone{display:flex !important;align-items:center;gap:.4rem;background:rgba(37,99,235,.15) !important;border:1px solid rgba(37,99,235,.35) !important;color:var(--blue-pale) !important;font-weight:600 !important;font-size:.82rem !important;transition:background .2s,border-color .2s !important}
.nav-phone:hover{background:rgba(37,99,235,.28) !important;border-color:var(--blue-light) !important;color:var(--white) !important}
.nav-cta{background:var(--blue) !important;color:#fff !important;margin-left:.4rem;font-weight:700 !important;font-size:.875rem !important;border:1px solid transparent;transition:background .2s,box-shadow .2s !important}
.nav-cta:hover{background:var(--blue-light) !important;box-shadow:0 0 24px rgba(37,99,235,.45) !important}
.ham{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;border:none;background:transparent}
.ham span{width:22px;height:2px;background:var(--off-white);border-radius:2px;display:block;transition:.3s}
.mob-menu{display:none;position:absolute;top:var(--nav-h);left:0;right:0;background:var(--dark2);border-bottom:1px solid var(--border);padding:1.5rem 5%;flex-direction:column;gap:.5rem}
.mob-menu a{display:block;color:var(--off-white);padding:.65rem 0;border-bottom:1px solid var(--border2);font-size:.95rem}
.mob-menu.open{display:flex}

/* HERO */
#hero{padding:5.5rem 5% 5rem;position:relative;overflow:hidden;background:linear-gradient(160deg,var(--dark) 0%,var(--dark2) 50%,#0a1428 100%)}
.hero-lines{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(37,99,235,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.07) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(ellipse 90% 70% at 50% 0%,black 0%,transparent 100%)}
.hero-blob{position:absolute;right:-200px;top:-100px;width:700px;height:700px;background:radial-gradient(circle,rgba(37,99,235,.12) 0%,transparent 65%);border-radius:50%;pointer-events:none}
.hero-in{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:5rem;align-items:center;position:relative;z-index:2}
.hero-eyebrow{display:inline-flex;align-items:center;gap:.6rem;border:1px solid rgba(96,165,250,.3);background:rgba(37,99,235,.1);padding:.4rem 1rem;border-radius:100px;font-size:.78rem;color:var(--blue-pale);font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1.5rem}
.pulse{width:5px;height:5px;background:var(--blue-bright);border-radius:50%;display:inline-block;animation:p 2s infinite}
@keyframes p{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
h1{font-family:'Raleway',sans-serif;font-weight:900;font-size:clamp(2.2rem,4.5vw,3.6rem);line-height:1.08;letter-spacing:-.025em;color:var(--white);margin-bottom:1.25rem}
.blue{color:var(--blue-bright)}
.hero-desc{font-size:1.05rem;color:var(--muted);font-weight:300;line-height:1.8;margin-bottom:2rem;max-width:480px}
.hero-acts{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:2.5rem}
.btn-blue{background:var(--blue);color:#fff;padding:.85rem 1.75rem;border-radius:var(--r);font-weight:700;font-size:.95rem;border:none;cursor:pointer;transition:background .2s,box-shadow .2s,transform .15s;display:inline-block}
.btn-blue:hover{background:var(--blue-light);box-shadow:0 0 28px rgba(37,99,235,.5);transform:translateY(-2px);color:#fff}
.btn-outline{border:1.5px solid rgba(96,165,250,.35);color:var(--blue-pale);padding:.85rem 1.75rem;border-radius:var(--r);font-weight:600;font-size:.95rem;transition:border-color .2s,background .2s,transform .15s;display:inline-block}
.btn-outline:hover{border-color:var(--blue-light);background:rgba(37,99,235,.1);transform:translateY(-2px);color:var(--white)}
.hero-trust{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
.avs{display:flex}
.avs div{width:32px;height:32px;border-radius:50%;border:2px solid var(--dark);background:linear-gradient(135deg,var(--blue),var(--dark3));margin-left:-8px;font-size:.7rem;display:grid;place-items:center;color:#fff;font-weight:700}
.avs div:first-child{margin-left:0}
.trust-txt{font-size:.82rem;color:var(--muted)}
.trust-txt strong{color:var(--white)}
.hero-card{background:var(--dark3);border:1px solid var(--border);border-radius:12px;padding:2rem;box-shadow:var(--shadow)}
.hero-card-title{font-family:'Raleway',sans-serif;font-weight:700;font-size:1rem;color:var(--white);margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border2);display:flex;align-items:center;gap:.5rem}
.hero-card-title::before{content:'';width:8px;height:8px;background:var(--blue);border-radius:50%;display:inline-block}
.svc-pill{display:flex;align-items:center;justify-content:space-between;padding:.85rem 1rem;margin-bottom:.6rem;background:var(--dark4);border:1px solid var(--border2);border-radius:var(--r);font-size:.875rem;transition:border-color .2s,background .2s}
.svc-pill:hover{border-color:rgba(96,165,250,.3);background:rgba(37,99,235,.08)}
.svc-pill-label{display:flex;align-items:center;gap:.6rem;color:var(--off-white);font-weight:500}
.badge{font-size:.7rem;font-weight:700;padding:.2rem .6rem;border-radius:100px;background:rgba(37,99,235,.2);color:var(--blue-pale);letter-spacing:.06em}
.emerg-bar{margin-top:1.25rem;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.3);border-radius:var(--r);padding:1rem;display:flex;align-items:center;gap:.75rem}
.emerg-bar-text{font-size:.8rem;color:var(--muted);line-height:1.5}
.emerg-bar-text strong{color:var(--white);display:block;font-size:.85rem}
.emerg-bar-text a{color:var(--blue-bright);font-weight:600}
.emerg-bar-text a:hover{color:var(--white)}

/* STATS */
.stats-bar{background:var(--dark2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2.5rem 5%}
.stats-in{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center}
.stat-num{font-family:'Raleway',sans-serif;font-weight:900;font-size:2.2rem;color:var(--white);line-height:1;letter-spacing:-.02em}
.stat-num span{color:var(--blue-bright)}
.stat-lbl{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-top:.4rem;font-weight:600}

/* SECTIONS */
.sec{padding:6rem 5%}
.sec-in{max-width:1080px;margin:0 auto}
.sec-tag{font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--blue-bright);margin-bottom:.85rem}
h2{font-family:'Raleway',sans-serif;font-weight:900;font-size:clamp(1.7rem,3.5vw,2.6rem);line-height:1.12;letter-spacing:-.025em;color:var(--white)}
.sec-sub{font-size:1rem;color:var(--muted);font-weight:300;line-height:1.8;margin-top:.85rem;max-width:520px}
.sec-hdr{margin-bottom:3.5rem}

/* SERVICES */
#services{background:var(--dark2)}
.svcs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.svc-card{background:var(--dark3);border:1px solid var(--border2);border-radius:10px;padding:2rem 1.75rem;transition:border-color .3s,transform .25s,box-shadow .3s;position:relative;overflow:hidden}
.svc-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--blue-bright));transform:scaleX(0);transform-origin:left;transition:transform .3s}
.svc-card:hover{border-color:rgba(96,165,250,.25);transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.35)}
.svc-card:hover::after{transform:scaleX(1)}
.svc-icon{font-size:1.75rem;margin-bottom:1.25rem;display:block}
.svc-card h3{font-family:'Raleway',sans-serif;font-weight:800;font-size:1.05rem;color:var(--white);margin-bottom:.65rem;letter-spacing:-.01em}
.svc-card p{font-size:.875rem;color:var(--muted);line-height:1.75;font-weight:300}
.svc-lnk{display:inline-flex;align-items:center;gap:.35rem;margin-top:1.1rem;font-size:.8rem;color:var(--blue-bright);font-weight:600;transition:gap .2s}
.svc-card:hover .svc-lnk{gap:.6rem}

/* PROCESS */
#process{background:var(--dark)}
.proc-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
.step-list{margin-top:2rem}
.step{display:flex;gap:1.25rem;padding:1.5rem 0;border-bottom:1px solid var(--border2)}
.step:last-child{border:none}
.step-n{width:40px;height:40px;border-radius:8px;background:rgba(37,99,235,.15);border:1px solid rgba(37,99,235,.25);display:grid;place-items:center;flex-shrink:0;font-family:'Raleway',sans-serif;font-weight:900;font-size:.9rem;color:var(--blue-bright)}
.step h4{font-family:'Raleway',sans-serif;font-weight:700;font-size:.95rem;color:var(--white);margin-bottom:.35rem}
.step p{font-size:.85rem;color:var(--muted);line-height:1.7;font-weight:300}
.why-box{background:var(--dark3);border:1px solid var(--border);border-radius:10px;padding:2.25rem}
.why-box h3{font-family:'Raleway',sans-serif;font-weight:800;font-size:1.15rem;color:var(--white);margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border2)}
.why-list{list-style:none}
.why-list li{display:flex;align-items:flex-start;gap:.75rem;padding:.7rem 0;border-bottom:1px solid var(--border2);font-size:.875rem;color:var(--off-white)}
.why-list li:last-child{border:none}
.why-list li::before{content:'✓';color:var(--blue-bright);font-weight:700;font-size:.85rem;margin-top:.1rem;flex-shrink:0}
.cta-callout{margin-top:1.75rem;background:rgba(37,99,235,.1);border:1px solid rgba(37,99,235,.25);border-radius:var(--r);padding:1.25rem;display:flex;align-items:center;gap:1rem}
.cta-callout-text{font-size:.85rem;color:var(--muted);line-height:1.5}
.cta-callout-text strong{color:var(--white);display:block;margin-bottom:.25rem}
.cta-callout-text a{color:var(--blue-bright);font-weight:700}
.cta-callout-text a:hover{color:var(--white)}

/* TESTIMONIALS */
#reviews{background:var(--dark2)}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.testi{background:var(--dark3);border:1px solid var(--border2);border-radius:10px;padding:2rem;transition:border-color .3s}
.testi:hover{border-color:rgba(96,165,250,.25)}
.stars{color:#f59e0b;font-size:.85rem;letter-spacing:.1em;margin-bottom:1rem}
.testi blockquote{font-size:.9rem;line-height:1.75;color:var(--off-white);font-style:italic;font-weight:300}
.testi blockquote::before{content:'"';font-size:2.5rem;color:var(--blue);line-height:0;vertical-align:-.7rem;margin-right:.2rem;font-style:normal;font-family:'Raleway',sans-serif;font-weight:900}
.testi-foot{margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border2);display:flex;align-items:center;gap:.75rem}
.testi-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--blue),#1e3a5f);display:grid;place-items:center;font-family:'Raleway',sans-serif;font-weight:800;font-size:.85rem;color:#fff;flex-shrink:0}
.testi-name{font-size:.82rem;color:var(--white);font-weight:600;display:block}
.testi-role{font-size:.75rem;color:var(--muted)}

/* EMERGENCY */
#emergency{background:linear-gradient(135deg,#061429 0%,#0a1f47 50%,#061429 100%);border-top:1px solid rgba(37,99,235,.25);border-bottom:1px solid rgba(37,99,235,.25);padding:4.5rem 5%;text-align:center}
.emerg-in{max-width:680px;margin:0 auto}
.emerg-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);padding:.35rem 1rem;border-radius:100px;font-size:.75rem;color:#fca5a5;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1.5rem}
#emergency h2{margin-bottom:.75rem}
#emergency p{color:var(--muted);font-size:1rem;font-weight:300;margin-bottom:2.25rem;line-height:1.7}
.emerg-acts{display:flex;align-items:center;justify-content:center;gap:1.25rem;flex-wrap:wrap}
.btn-call{display:inline-flex;align-items:center;gap:.6rem;background:#fff;color:var(--dark);padding:1rem 2rem;border-radius:var(--r);font-family:'Raleway',sans-serif;font-weight:900;font-size:1.1rem;letter-spacing:-.01em;transition:background .2s,box-shadow .2s,transform .15s}
.btn-call:hover{background:var(--blue-pale);transform:translateY(-2px);box-shadow:0 0 32px rgba(255,255,255,.15);color:var(--dark)}
.btn-email-alt{display:inline-flex;align-items:center;gap:.5rem;border:1.5px solid rgba(96,165,250,.35);color:var(--blue-pale);padding:1rem 1.75rem;border-radius:var(--r);font-weight:600;font-size:.95rem;transition:border-color .2s,background .2s,transform .15s}
.btn-email-alt:hover{border-color:var(--blue-light);background:rgba(37,99,235,.1);color:var(--white);transform:translateY(-2px)}

/* CONTACT */
#contact{background:var(--dark)}
.ct-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:5rem;align-items:start}
.ct-info{position:sticky;top:calc(var(--nav-h) + 2rem)}
.cd{display:flex;align-items:flex-start;gap:1rem;margin-bottom:1.75rem}
.cd-icon{width:42px;height:42px;border-radius:8px;flex-shrink:0;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.2);display:grid;place-items:center;font-size:1.1rem}
.cd-lbl{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue-bright);display:block;margin-bottom:.2rem}
.cd a,.cd span{color:var(--off-white);font-size:.9rem;font-weight:400;transition:color .2s}
.cd a:hover{color:var(--blue-bright)}
.divider{height:1px;background:var(--border2);margin:2rem 0}
.hours-title{font-family:'Raleway',sans-serif;font-weight:700;font-size:.85rem;color:var(--white);margin-bottom:1rem;text-transform:uppercase;letter-spacing:.08em}
.hr-row{display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:.5rem}
.hr-row span:first-child{color:var(--muted)}
.hr-row span:last-child{color:var(--white);font-weight:600}
.hr-row.hi span{color:var(--blue-bright)}
.form-box{background:var(--dark3);border:1px solid var(--border);border-radius:12px;padding:2.5rem;box-shadow:var(--shadow)}
.form-title{font-family:'Raleway',sans-serif;font-weight:800;font-size:1.2rem;color:var(--white);margin-bottom:1.75rem;padding-bottom:1.25rem;border-bottom:1px solid var(--border2)}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem}
.f-g{display:flex;flex-direction:column;gap:.45rem;margin-bottom:1.1rem}
.f-g label{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(232,237,245,.55)}
.f-g input,.f-g select,.f-g textarea{background:rgba(255,255,255,.04);border:1px solid rgba(96,165,250,.15);color:var(--white);padding:.78rem 1rem;border-radius:var(--r);font-size:.9rem;outline:none;width:100%;transition:border-color .2s,background .2s;-webkit-appearance:none;font-family:'Open Sans',sans-serif}
.f-g select{cursor:pointer}
.f-g select option{background:var(--dark3);color:var(--white)}
.f-g input::placeholder,.f-g textarea::placeholder{color:rgba(143,163,191,.5)}
.f-g input:focus,.f-g select:focus,.f-g textarea:focus{border-color:rgba(96,165,250,.5);background:rgba(37,99,235,.06)}
.f-g textarea{resize:vertical;min-height:120px;line-height:1.6}
.f-submit{width:100%;background:var(--blue);color:#fff;border:none;padding:1rem;border-radius:var(--r);font-family:'Raleway',sans-serif;font-weight:800;font-size:1rem;letter-spacing:.02em;cursor:pointer;transition:background .2s,box-shadow .2s,transform .15s;margin-top:.5rem}
.f-submit:hover{background:var(--blue-light);box-shadow:0 0 28px rgba(37,99,235,.5);transform:translateY(-2px)}
.f-note{text-align:center;font-size:.75rem;color:var(--muted);margin-top:1rem}
#form-success{display:none;text-align:center;padding:3.5rem 2rem}
#form-success .s-icon{font-size:3rem;margin-bottom:1rem}
#form-success h3{font-family:'Raleway',sans-serif;font-weight:800;font-size:1.5rem;color:var(--white);margin-bottom:.75rem}
#form-success p{color:var(--muted);font-size:.95rem;line-height:1.7}

/* FOOTER */
footer{background:#050810;border-top:1px solid var(--border);padding:4rem 5% 2rem}
.ft-grid{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:3rem}
.ft-brand .logo{font-size:1.25rem;margin-bottom:1rem;display:inline-flex}
.ft-brand p{font-size:.84rem;color:var(--muted);line-height:1.75;font-weight:300;max-width:260px;margin-bottom:1.25rem}
.ft-contact-item{display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem;font-size:.82rem}
.ft-contact-item a{color:var(--muted);transition:color .2s}
.ft-contact-item a:hover{color:var(--blue-bright)}
.ft-col-title{font-family:'Raleway',sans-serif;font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(232,237,245,.45);margin-bottom:1.25rem}
.ft-col ul{list-style:none}
.ft-col ul li{margin-bottom:.65rem}
.ft-col ul a{color:var(--muted);font-size:.85rem;transition:color .2s}
.ft-col ul a:hover{color:var(--blue-bright)}
.ft-emergency-box{margin-top:1.5rem;padding:1rem;background:rgba(37,99,235,.1);border:1px solid rgba(37,99,235,.2);border-radius:6px}
.ft-emergency-box p{font-size:.78rem;color:var(--muted);line-height:1.6}
.ft-emergency-box strong{color:var(--white);display:block;margin-bottom:.3rem}
.ft-emergency-box a{color:var(--blue-bright);font-weight:700}
.ft-emergency-box a:hover{color:var(--white)}
.ft-bottom{max-width:1080px;margin:2.5rem auto 0;padding-top:1.5rem;border-top:1px solid var(--border2);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.ft-bottom p{font-size:.78rem;color:rgba(143,163,191,.45)}
.ft-bottom a{color:var(--blue-bright);transition:color .2s}
.ft-bottom a:hover{color:var(--white)}

/* REVEAL */
